    <screens>
        <name>Basics</name>
        <label>Project basics</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Problem_Solution</targetReference>
        </connector>
        <fields>
            <name>Basics_Help</name>
            <fieldText
      >&lt;p&gt;Start with the project name, cloud and dates. Status stays Draft or In Progress until you publish from the record page.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Name_Input</name>
            <dataType>String</dataType>
            <fieldText>Project Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Status_Input</name>
            <choiceReferences>Draft_Choice</choiceReferences>
            <choiceReferences>In_Progress_Choice</choiceReferences>
            <dataType>String</dataType>
            <defaultValue>
                <stringValue>Draft</stringValue>
            </defaultValue>
            <fieldText>Status</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Cloud_Input</name>
            <choiceReferences>Sales_Cloud_Choice</choiceReferences>
            <choiceReferences>Service_Cloud_Choice</choiceReferences>
            <choiceReferences>Experience_Cloud_Choice</choiceReferences>
            <choiceReferences>Education_Cloud_Choice</choiceReferences>
            <choiceReferences>Platform_Choice</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Cloud</fieldText>
            <fieldType>MultiSelectCheckboxes</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Technologies_Input</name>
            <dataType>String</dataType>
            <fieldText>Technologies</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Start_Date_Input</name>
            <dataType>Date</dataType>
            <fieldText>Start Date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
